# ── Database (SQLite) ─────────────────────────────────────────
# Relative paths are resolved from the prisma/ folder.
# Local / PM2 on VPS:
DATABASE_URL="file:../db/custom.db"
# Docker: use an absolute path on the mounted volume instead:
# DATABASE_URL="file:/app/db/custom.db"

# ── WhatsApp ──────────────────────────────────────────────────
# Company WhatsApp number that receives inquiries (international format, digits only)
WHATSAPP_NOTIFY_PHONE="201039661221"

# Optional — automatic server-side alerts via Meta WhatsApp Cloud API.
# Without these, the visitor gets a "Continue on WhatsApp" button after submitting
# that opens a chat to WHATSAPP_NOTIFY_PHONE with the inquiry pre-filled.
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
